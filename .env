# Database Configuration
# Replace YOUR_PASSWORD with your PostgreSQL password
DATABASE_URL=postgresql://postgres:5588@host.docker.internal:5432/library_db

#DATABASE_URL=postgresql://postgres:5588@localhost:5432/library_db


# Session Secret (you can keep this as is or change it)
SESSION_SECRET=my-super-secret-key-library-management-2025
POSTGRES_HOST_AUTH_METHOD=trust